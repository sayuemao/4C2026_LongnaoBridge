# ============================================
# Unity 项目 Git 忽略规则
# 基于 GitHub 官方 Unity.gitignore 模板
# https://github.com/github/gitignore/blob/main/Unity.gitignore
# ============================================

# --- 系统文件 ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Unity 生成文件 ---
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# --- Blender 文件（Unity 支持导入）---
*.blend1
*.blend1.meta

# --- 内存捕获和录制 ---
/[Mm]emoryCaptures/
/[Rr]ecordings/

# --- Asset Store 工具插件（可选取消注释）---
# /[Aa]ssets/AssetStoreTools*

# --- IDE 和编辑器配置 ---
# JetBrains Rider
/[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user
.idea/

# Visual Studio
.vs/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
ExportedObj/
.consulo/

# Gradle
.gradle/

# --- Unity 调试和崩溃报告 ---
sysinfo.txt
mono_crash.*
*.pidb.meta
*.pdb.meta
*.mdb.meta

# --- 构建输出 ---
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# --- 第三方服务 ---
crashlytics-build.properties

# --- 测试相关 ---
InitTestScene*.unity*

# --- Addressables ---
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# --- Visual Scripting ---
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# --- Play Mode 测试自动生成场景 ---
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# --- LFS 锁定文件（可选）---
*.lfs.lock

# --- 本地化临时文件 ---
/[Ll]ocalizationCache/

# --- 包管理器缓存 ---
/Packages/.npmcache

# --- 编辑器状态 ---
/[Aa]ssets/SceneTemplateCache/

# --- 其他常见忽略 ---
*.swp
*.swo
*~
.project
.classpath
.settings/
node_modules/
